use flake

# This repository's rk is the one it just built, never a copy pinned in the
# flake: a stale binary carries stale embedded sources and reports drift that is not
# there. The justfile does the same for the manual hook sweep, so an interactive
# commit and a swept one resolve one binary. cargo build writes it.
PATH_add target/debug

# gh pages its output whenever stdout is a terminal, which stalls scripted
# checks; blank disables it.
export GH_PAGER=""

# Developer-specific values — absolute paths, credentials — live here and are
# never committed.
source_env_if_exists .envrc.local

# Warn when a newer sdd release is out. The check reads the network at most
# once a week, or one hour after a failed read, writes nothing but its cache,
# and never moves the pin: a person moves it with
# `sdd self-depend sync --apply`. rk has no such line: this repository builds
# its own rk from source and pins none.
sdd self-depend check || true

# Warn once a day about working-tree copies in the Nix store.
if command -v exobrain >/dev/null 2>&1; then exobrain store-guard --daily || true; fi
