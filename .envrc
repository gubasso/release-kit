# shellcheck shell=bash
use flake

# Route each rustc call through the kache of the host. CI enters the devshell
# without direnv, so it builds without kache and needs none. KACHE_DISABLED=1
# runs one command without it.
export RUSTC_WRAPPER=kache

# gh pages its output whenever stdout is a terminal, which stalls scripted
# checks; blank disables it.
export GH_PAGER=""

# The project environment file holds values that the operator chooses. It
# lives outside the repository and is never committed. A credential belongs
# behind a credential gateway, not in an environment variable.
project_env=$HOME/.config/project-env/release-kit.env
if [ -r "$project_env" ]; then source_env "$project_env"; fi

# The host supplies exobrain. The first line warns about an old nixpkgs
# pin, a newer release of a tag-pinned flake input, a newer CLI, and newer
# hook revisions than .pre-commit-config.yaml pins. The second warns once
# a day about working-tree copies in the Nix store, and runs
# `prek cache gc` once a week. Each exits 0 and moves nothing.
exobrain outdated || true
exobrain store-guard --daily || true
