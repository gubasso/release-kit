# shellcheck shell=bash
use flake

# Route each rustc call through the kache of the host. CI enters the devshell
# without direnv, so it builds without kache and needs none. KACHE_DISABLED=1
# runs one command without it.
export RUSTC_WRAPPER=kache

# gh pages its output whenever stdout is a terminal, which stalls scripted
# checks; blank disables it.
export GH_PAGER=""

# Developer-specific values — absolute paths, credentials — live here and are
# never committed.
source_env_if_exists .envrc.local

# Warn when a newer sdd release is out. The check reads the network at most
# once a week, or one hour after a failed read, writes nothing but its cache,
# and never moves the pin: a person moves it with
# `sdd self-depend sync --apply`. The rk line does the same for the rk
# release that flake.nix pins, which manages this repository.
sdd self-depend check || true
rk self-depend check || true

# The host supplies exobrain. The first line warns about a newer CLI or
# newer hook revisions than .pre-commit-config.yaml pins. The second warns
# once a day about working-tree copies in the Nix store, and runs
# `prek cache gc` once a week. Each exits 0 and moves nothing.
exobrain hooks status || true
exobrain store-guard --daily || true
