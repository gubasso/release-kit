#!/usr/bin/env sh
# Store the bot App credentials as repository secrets. Each value travels on
# standard input — gh reads stdin when --body is omitted — so neither ever
# enters a process argument list; printf is a shell builtin, so no external
# process sees the value either. The private key's PEM armor and newlines
# land verbatim. Overwriting is correct: a rotated credential must be able to
# replace an old one.
set -eu
: "${RK_REPO:?rk sets this; run this script through rk setup}"
: "${RK_BOT_APP_ID:?export the App ID; the walkthrough is rk forge github}"
: "${RK_BOT_PRIVATE_KEY:?export the App private key contents; the walkthrough is rk forge github}"

printf '%s' "$RK_BOT_APP_ID" | gh secret set RELEASE_BOT_APP_ID --repo "$RK_REPO"
printf '%s' "$RK_BOT_PRIVATE_KEY" | gh secret set RELEASE_BOT_APP_PRIVATE_KEY --repo "$RK_REPO"
echo 'check: lists both secrets'
gh secret list --repo "$RK_REPO"
