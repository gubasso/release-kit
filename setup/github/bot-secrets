#!/usr/bin/env sh
# Store the bot App credentials where only a release job reads them. Neither
# value enters a process argument list: gh reads a secret from standard
# input when --body is omitted, and printf is a shell builtin, so no
# external process sees the App ID either.
#
# The private key arrives on this script's own standard input, written there
# by rk from the file it validated. rk holds the bytes; this script never
# learns where they came from, so nothing between rk's check and gh's read
# can substitute a different file. The App ID's gh call takes its standard
# input from the pipe on its own line, which leaves this script's standard
# input untouched for the one call that needs it.
#
# RELEASE_BOT_APP_ID feeds the client-id input of every landed workflow's
# app-token step, which GitHub reads as the JWT issuer.
#
# rk runs this script once per scope that RK_BOT_SECRETS_SCOPE names:
#   environment        the environment RK_BOT_SECRETS_ENVIRONMENT, whose
#                      deployment policy admits the release refs alone, then
#                      both secrets in it.
#   repository         both secrets as repository secrets, where a private
#                      repository's plan holds no environment secrets.
#   remove-repository  the repository copies of both secrets, which rk asks
#                      for only once every release ref runs a workflow that
#                      names the environment.
#
# The armor and newlines land verbatim. Overwriting is correct: a rotated
# credential must be able to replace an old one.
set -eu
# A pattern carries a wildcard, which the shell must not expand against the
# files of the working directory.
set -f
: "${RK_REPO:?rk sets this; run this script through rk setup}"
scope="${RK_BOT_SECRETS_SCOPE:-repository}"

# rk passes a JSON array of names, which carry no quote, comma, or
# whitespace, so one name per line needs no JSON parser.
names_of() { printf '%s' "$1" | tr -d '[]"' | tr ',' '\n'; }

case "$scope" in
  repository)
    : "${RK_BOT_APP_ID:?export the App ID; the walkthrough is rk forge github}"
    printf '%s' "$RK_BOT_APP_ID" | gh secret set RELEASE_BOT_APP_ID --repo "$RK_REPO"
    gh secret set RELEASE_BOT_APP_PRIVATE_KEY --repo "$RK_REPO"
    echo 'check: lists both secrets'
    gh secret list --repo "$RK_REPO"
    ;;
  environment)
    : "${RK_BOT_APP_ID:?export the App ID; the walkthrough is rk forge github}"
    : "${RK_BOT_SECRETS_ENVIRONMENT:?rk sets this; run this script through rk setup}"
    : "${RK_ENVIRONMENT_BRANCH_PATTERNS:?rk sets this; run this script through rk setup}"
    : "${RK_ENVIRONMENT_TAG_PATTERNS:?rk sets this; run this script through rk setup}"
    environment="$RK_BOT_SECRETS_ENVIRONMENT"
    base="repos/$RK_REPO/environments/$environment"
    # The environment, which admits only the refs its own policies name. A
    # missing environment, or one with another policy, is written; one that
    # already holds the owned policy is left alone.
    current="$(gh api "$base" -q '.deployment_branch_policy | "\(.protected_branches) \(.custom_branch_policies)"' 2>/dev/null || true)"
    if [ "$current" != "false true" ]; then
      printf '%s' '{"deployment_branch_policy":{"protected_branches":false,"custom_branch_policies":true}}' \
        | gh api -X PUT "$base" --input - >/dev/null
      echo "ok $environment admits only the refs its policies name"
    fi
    wanted="$({
      for name in $(names_of "$RK_ENVIRONMENT_BRANCH_PATTERNS"); do printf 'branch %s\n' "$name"; done
      for name in $(names_of "$RK_ENVIRONMENT_TAG_PATTERNS"); do printf 'tag %s\n' "$name"; done
    })"
    existing="$(gh api "$base/deployment-branch-policies?per_page=100" \
      -q '.branch_policies[] | "\(.id) \(.type) \(.name)"')"
    # Every policy the setup does not own goes, then every owned one that
    # is missing is created, so the policy ends exactly the owned one.
    printf '%s\n' "$existing" | while read -r id kind name; do
      [ -n "$id" ] || continue
      if ! printf '%s\n' "$wanted" | grep -qxF "$kind $name"; then
        gh api -X DELETE "$base/deployment-branch-policies/$id" >/dev/null
        echo "ok removed the $kind policy $name from $environment"
      fi
    done
    printf '%s\n' "$wanted" | while read -r kind name; do
      [ -n "$kind" ] || continue
      if ! printf '%s\n' "$existing" | awk -v k="$kind" -v n="$name" '$2 == k && $3 == n { f = 1 } END { exit !f }'; then
        gh api -X POST "$base/deployment-branch-policies" -f "name=$name" -f "type=$kind" >/dev/null
        echo "ok $environment admits the $kind $name"
      fi
    done
    printf '%s' "$RK_BOT_APP_ID" | gh secret set RELEASE_BOT_APP_ID --env "$environment" --repo "$RK_REPO"
    gh secret set RELEASE_BOT_APP_PRIVATE_KEY --env "$environment" --repo "$RK_REPO"
    echo "check: lists both secrets of $environment"
    gh secret list --env "$environment" --repo "$RK_REPO"
    ;;
  remove-repository)
    stored="$(gh secret list --repo "$RK_REPO")"
    for name in RELEASE_BOT_APP_ID RELEASE_BOT_APP_PRIVATE_KEY; do
      if printf '%s\n' "$stored" | awk -v n="$name" '$1 == n { f = 1 } END { exit !f }'; then
        gh secret delete "$name" --repo "$RK_REPO"
        echo "ok removed the repository secret $name"
      fi
    done
    echo 'check: lists no bot secret at the repository level'
    gh secret list --repo "$RK_REPO"
    ;;
  *)
    echo "RK_BOT_SECRETS_SCOPE is $scope; rk sets it to environment, repository, or remove-repository" >&2
    exit 1
    ;;
esac
