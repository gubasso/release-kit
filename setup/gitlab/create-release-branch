#!/usr/bin/env sh
# Create the release branch at the integration branch's tip, before its
# protection exists, so no rule governs the creation. Idempotent: an existing
# release branch that is an ancestor of, or equal to, the integration branch
# is the normal state after releases and is left exactly where it is; one
# carrying commits the integration branch lacks is not a branch this setup
# created, and deleting or moving it is not this script's call.
set -eu
: "${RK_REPO:?rk sets this; run this script through rk setup}"
: "${RK_INTEGRATION_BRANCH:?rk sets this; run this script through rk setup}"
: "${RK_RELEASE_BRANCH:?rk sets this; run this script through rk setup}"

project="$(printf '%s' "$RK_REPO" | sed 's|/|%2F|g')"

# The forge CLI may pretty-print JSON; stripping whitespace makes every
# pattern below hold for the compact and the pretty form alike, and no
# value a pattern touches can carry whitespace of its own.
compact() { tr -d ' \t\r\n'; }

if glab api "projects/$project/repository/branches/$RK_RELEASE_BRANCH" >/dev/null 2>&1; then
  # Commits reachable from the release branch and not from the integration
  # branch; an empty list means the release branch is an ancestor or equal.
  # The comparison is captured first and fails closed: a comparison that
  # cannot be read must never read as an empty one.
  if ! compare="$(glab api "projects/$project/repository/compare?from=$RK_INTEGRATION_BRANCH&to=$RK_RELEASE_BRANCH")"; then
    echo "FAIL the comparison of $RK_INTEGRATION_BRANCH and $RK_RELEASE_BRANCH could not be read" >&2
    echo 'remediation: check authentication and rerun' >&2
    exit 1
  fi
  ahead="$(printf '%s' "$compare" | grep -c '"short_id"' || true)"
  if [ "$ahead" = "0" ]; then
    echo "ok $RK_RELEASE_BRANCH exists; leaving it where it is"
  else
    echo "FAIL $RK_RELEASE_BRANCH carries commits $RK_INTEGRATION_BRANCH does not" >&2
    echo 'remediation: finish the back-merge if a release is mid-flight; otherwise inspect the branch before rerunning' >&2
    exit 1
  fi
else
  glab api -X POST "projects/$project/repository/branches" \
    -f "branch=$RK_RELEASE_BRANCH" -f "ref=$RK_INTEGRATION_BRANCH" >/dev/null
  echo "ok $RK_RELEASE_BRANCH created at $RK_INTEGRATION_BRANCH"
fi

echo "check: prints one commit id for $RK_RELEASE_BRANCH"
glab api "projects/$project/repository/branches/$RK_RELEASE_BRANCH" | compact | grep -o '"id":"[^"]*"' | head -n 1
