{
  "markdown": {
    "textWrap": "never"
  },
  "json": {
    "indentWidth": 2
  },
  "includes": [
    "**/*.md",
    "**/*.json",
    "**/*.jsonc"
  ],
  // The generated files follow their generator (the dev environment rule of
  // nix-secrets, home/apps/claude-session/rules/dev-environment.md):
  // release-plz writes CHANGELOG.md, rk writes SECURITY.md and the
  // .release-kit files, and sdd writes the rest.
  "excludes": [
    ".git",
    "node_modules",
    "target",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    ".release-kit/manifest.json",
    ".release-kit/setup-proof.json",
    ".spec-driven-docs/manifest.json",
    "_docs/.markdownlint-cli2.jsonc"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.0.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ]
}
