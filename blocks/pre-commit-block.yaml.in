# BEGIN release-kit
# The release convention's hooks. Install every stage they run at:
# pre-commit install --hook-type pre-commit --hook-type commit-msg --hook-type pre-push
RK_SWEEP_NOTERK_MESSAGE_GUARDSRK_TRUNK_COMMIT_GUARD  - repo: local
    hooks:
RK_BRANCH_NAME_GUARDRK_WORKTREE_GUARDRK_TRUNK_PUSH_GUARDRK_TAG_GUARD      - id: rk-status-check
        name: rk status check
        language: system
        pass_filenames: false
        entry: rk status --check --target .
        files: '^(\.github/workflows/|\.gitlab-ci\.yml$|\.gitlab/ci/|AGENTS\.md$|\.release-kit/|\.pre-commit-config\.yaml$RK_STATUS_RELEASE_FILES)'
# END release-kit
