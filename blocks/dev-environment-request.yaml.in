RK_DEV_SETUP_STEPSRK_DEV_GIT_USER
      # A line that carries a candidate's version keeps this half out of the
      # candidate numbering: release-plz would propose the next rc in a
      # request. The request returns once the promotion writes the stable
      # version, and it then proposes that version with its changelog. Cargo
      # reads the version, so any valid manifest form and an inherited
      # workspace version count, and a version it cannot read fails the job.
      - name: hold the request while the line carries a candidate
        id: candidate
        env:
          REF: ${{ github.ref_name }}
        run: |
          set -eu
          case "$REF" in
            RK_LINE_PREFIX*) ;;
            *)
              echo "held=false" >> "$GITHUB_OUTPUT"
              exit 0
              ;;
          esac
          metadata="$(RK_DEV_RUN cargo metadata --no-deps --format-version 1 --offline)"
          version="$(printf '%s' "$metadata" | jq -r --arg manifest "$PWD/Cargo.toml" '.packages[] | select(.manifest_path == $manifest) | .version')"
          if [ -z "$version" ]; then
            echo "cargo names no package version for $PWD/Cargo.toml; no request opens past an unreadable manifest." >&2
            exit 1
          fi
          case "$version" in
            *-*)
              echo "$REF carries the candidate $version; no release request until it is promoted."
              echo "held=true" >> "$GITHUB_OUTPUT"
              ;;
            *)
              echo "held=false" >> "$GITHUB_OUTPUT"
              ;;
          esac
      # release-plz opens a request for any change to a file the crate ships.
      # A release also needs a releasing commit among the commits that made
      # that change: feat, fix, or perf, or a breaking change. Where none is,
      # release-pr is skipped and the reason logged; the request opens on the
      # first push that carries one, and its changelog keeps every commit.
      - name: judge whether a releasing commit changed the package
        id: eligible
        if: steps.candidate.outputs.held != 'true'
        run: |
          set -eu
          answer="$(RK_DEV_RUN rk release eligible)"
          printf '%s\n' "$answer"
          case "$answer" in
            eligible:*)
              echo "eligible=true" >> "$GITHUB_OUTPUT"
              ;;
            *)
              echo "release-pr skipped: ${answer#not eligible: }"
              echo "eligible=false" >> "$GITHUB_OUTPUT"
              ;;
          esac
      # The request half writes the whole JSON report as the pr output. The
      # arm below reads the first request number in it, which is the one
      # request release-plz maintains, and reads none where it opened none.
      - name: release-pr
        id: release-pr
        if: steps.candidate.outputs.held != 'true' && steps.eligible.outputs.eligible == 'true'
        env:
          GITHUB_TOKEN: ${{ steps.app-token.outputs.token }}
        run: |
          set -eu
          output="$(RK_DEV_RUN release-plz release-pr --git-token "$GITHUB_TOKEN" --repo-url "https://github.com/$GITHUB_REPOSITORY" -o json)"
          printf '%s\n' "$output"
          printf 'pr=%s\n' "$(printf '%s' "$output" | tr -d '\n')" >> "$GITHUB_OUTPUT"
